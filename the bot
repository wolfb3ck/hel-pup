@bot.command(name='leaderboard', aliases=['lb'], help='Show the server leaderboard')
async def leaderboard(ctx, top: int = 10):
    # Convert user_data to a list of tuples and sort by level (descending)
    sorted_users = sorted(
        [(user_id, data) for user_id, data in user_data.items()],
        key=lambda x: x[1]['level'],
        reverse=True
    )
    
    embed = discord.Embed(
        title="🏆 Server Leaderboard 🏆",
        color=discord.Color.gold()
    )
    
    for i, (user_id, data) in enumerate(sorted_users[:top], 1):
        try:
            user = await bot.fetch_user(int(user_id))  # This works even if user isn't cached
            embed.add_field(
                name=f"{i}. {user.display_name}",
                value=f"Level: {data['level']} | XP: {data['xp']}",
                inline=False
            )
        except:
            continue  # Skip if user not found
    
    if not embed.fields:  # If no users were added
        embed.description = "No users found on the leaderboard!"
    
    await ctx.send(embed=embed)

