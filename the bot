# Leveling system
user_data = defaultdict(lambda: {'xp': 0, 'level': 0, 'messages': 0})

def save_data():
    with open('user_data.json', 'w') as f:
        json.dump(dict(user_data), f)

def load_data():
    try:
        with open('user_data.json', 'r') as f:
            data = json.load(f)
            for user_id, stats in data.items():
                user_data[user_id] = stats
    except (FileNotFoundError, json.JSONDecodeError):
        pass

# Music queue
music_queues = defaultdict(deque)
current_song = {}

def after_playing(error, ctx):
    if error:
        print(f'Player error: {error}')
    asyncio.run_coroutine_threadsafe(play_next(ctx), bot.loop)

async def play_next(ctx):
    if not ctx.voice_client:
        return
        
    if music_queues[ctx.guild.id]:
        next_song = music_queues[ctx.guild.id].popleft()
        current_song[ctx.guild.id] = next_song
        ctx.voice_client.play(next_song, after=lambda e: after_playing(e, ctx))
        await ctx.send(f"Now playing: {next_song.title}")
    else:
        current_song.pop(ctx.guild.id, None)
        await ctx.send("Queue is empty! Add more songs with !play")

