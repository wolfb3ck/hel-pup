            "Ball?! I love balls! Throw it! Throw it! 🎾",
            "Bark bark! *wags tail excitedly* 🐕"
        ]
        await message.channel.send(random.choice(responses))
    elif 'good boy' in content or 'good girl' in content:
        await message.channel.send("*wags tail happily* 😊")
    elif 'treat' in content:
        await message.channel.send("*perks up ears* Did someone say treat? 🦴")
    
    await bot.process_commands(message)

def calculate_xp_for_level(level):
    return 5 * (level ** 2) + 50 * level + 100

async def check_level_up(user_id):
    data = user_data[user_id]
    xp_needed = calculate_xp_for_level(data['level'])
    if data['xp'] >= xp_needed:
        data['level'] += 1
        data['xp'] = 0
        save_data()
        
        user = bot.get_user(int(user_id))
        if not user:
            return False
        
        channel = bot.get_channel(LEVEL_CHANNEL_ID)
        if channel:
            await channel.send(f"🎉 {user.display_name} has leveled up to level {data['level']}! 🎉")
        return True
    return False

