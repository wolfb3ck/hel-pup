@bot.command(name='dogfact', help='Get a random dog fact')
async def dogfact(ctx):
    api_endpoints = [
        "https://dog-facts-api.herokuapp.com/api/v1/resources/dogs?number=1",
        "https://some-random-api.ml/facts/dog",
        "https://api.aakhilv.me/fun/facts?type=dog"
    ]
    
    async with aiohttp.ClientSession() as session:
        for endpoint in api_endpoints:
            try:
                async with session.get(endpoint, timeout=3) as response:
                    if response.status == 200:
                        data = await response.json()
                        # Different APIs return data in different formats
                        if "facts" in data:
                            fact = data['facts'][0]
                        elif "fact" in data:
                            fact = data['fact']
                        elif isinstance(data, list) and "fact" in data[0]:
                            fact = data[0]['fact']
                        else:
                            continue
                            
                        await ctx.send(f"🐕 **Dog Fact:** {fact}")
                        return
            except:
                continue
    
    # If all APIs fail, use a local fallback
    local_facts = [
        "Dogs' noses are wet to help absorb scent chemicals!",
        "A dog's sense of smell is 40x better than humans!",
        "The Basenji dog doesn't bark, it yodels!",
        "Dogs dream like humans do!",
        "A dog's nose print is unique, like a human fingerprint!"
    ]
    await ctx.send(f"🐕 **Dog Fact:** {random.choice(local_facts)}")
    
